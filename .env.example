# Supabase projesi: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable (ya da eski adıyla anon) anahtar; tarayıcıda kullanılır, RLS ile korunur
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret (ya da eski adıyla service_role) anahtar; YALNIZCA sunucuda. Asla NEXT_PUBLIC_ ile başlatmayın.
SUPABASE_SECRET_KEY=sb_secret_...

# Sitenin yayın adresi (sitemap, paylaşım görselleri, bildirim e-postasındaki bağlantı)
NEXT_PUBLIC_SITE_URL=https://www.coffeehousetr.com

# İsteğe bağlı: IP adreslerini özetlerken kullanılan gizli değer (uzun, rastgele bir metin)
RATE_LIMIT_SALT=

# İsteğe bağlı: yeni başvuru e-posta bildirimi (resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=basvuru@coffeehousetr.com
NOTIFY_EMAIL_FROM=Coffee House <bildirim@coffeehousetr.com>
